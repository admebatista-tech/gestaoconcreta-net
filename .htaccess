# Gestão Concreta (gestaoconcreta.net) — servido a partir desta pasta.
Options -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /gestaoconcreta-net/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /gestaoconcreta-net/
# Pasta sem barra no fim: redireciona para o endereço com barra (no domínio público).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} ^/gestaoconcreta-net/(.+)$
RewriteRule ^ https://gestaoconcreta.net/%1/ [R=301,L]
# Bloqueia a pasta de publicação.
RewriteRule ^deploy(/|$) - [F]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(html)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "^.+-[A-Za-z0-9_-]{8}\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
